# Copy to repository root as .env.production (chmod 600). Never use dev credentials/data.
DOMAIN=union.example.com
TLS_EMAIL=operator@example.com
DB_PASSWORD=
APP_ENCRYPTION_KEY=
AUTH_THROTTLE_KEY=
PAYSTACK_SECRET_KEY=
APP_GOOGLE_CLIENT_ID=
APP_MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
CLAMAV_HOST=
CLAMAV_PORT=3310
AGE_RECIPIENT=
BACKUP_BUCKET=
BACKUP_PREFIX=cums
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=

# Private receipts: local for development, s3 for a private provisioned bucket.
APP_RECEIPT_STORAGE=local
APP_RECEIPT_S3_BUCKET=
APP_RECEIPT_S3_PREFIX=receipts
APP_RECEIPT_S3_REGION=us-east-1
APP_RECEIPT_S3_ENDPOINT=
APP_RECEIPT_S3_PATH_STYLE=false
# AWS credential chain is used; never put credentials in frontend configuration.
AWS_SESSION_TOKEN=
