# Copy to .env. Replace all production values; never commit .env.
DB_PASSWORD=local-dev-only
DB_URL=jdbc:postgresql://localhost:5432/cums
DB_USER=cums
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
AUTH_THROTTLE_KEY=replace-with-openssl-rand-base64-32
APP_ALLOWED_ORIGIN=http://localhost:5173
APP_COOKIE_SECURE=false
# Optional Google Identity Services web client ID. Omit until configured in Google Cloud.
# APP_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# APP_PASSKEY_RP_ID=localhost
# Only with SPRING_PROFILES_ACTIVE=dev. Keep the email for local full permissions;
# the password is needed only when the account is first created.
# DEV_BOOTSTRAP_EMAIL=admin@invalid.example
# DEV_BOOTSTRAP_PASSWORD=replace-with-a-unique-passphrase
# DEV_BOOTSTRAP_ROLE=ADMIN
PAYSTACK_SECRET_KEY=replace-with-test-secret-if-used
SMTP_HOST=localhost
SMTP_PORT=1025
# Fictitious local ledger fixtures; effective only in the dev profile.
DEV_SAMPLE_DATA=false

# fake is allowed only in the dev profile; production uses paystack and needs a real key.
PAYMENT_PROVIDER=fake
APP_UPLOAD_DIR=./private-uploads
# Outbox persists while email delivery is disabled (MailHog remains deferred).
APP_MAIL_ENABLED=false
SMTP_FROM=credit-union@localhost
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
# Optional private ClamAV daemon. If configured, uploads fail closed on scanner errors.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Private receipts: local for development, s3 for a private provisioned bucket.
APP_RECEIPT_STORAGE=local
APP_RECEIPT_S3_BUCKET=
APP_RECEIPT_S3_PREFIX=receipts
APP_RECEIPT_S3_REGION=us-east-1
APP_RECEIPT_S3_ENDPOINT=
APP_RECEIPT_S3_PATH_STYLE=false
# AWS credential chain is used; never put credentials in frontend configuration.
AWS_SESSION_TOKEN=
